<?xml version="1.0" encoding="utf-8"?>
<!-- Layout visual para el Widget de Escritorio de la racha de días. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Icono de fuego de la racha -->
    <TextView
        android:id="@+id/tvWidgetIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔥"
        android:textSize="36sp" />

    <!-- Contador de días en racha -->
    <TextView
        android:id="@+id/tvWidgetStreak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5 Días"
        android:textColor="#FF9800"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Etiqueta con el nombre de la app -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Racha DaySinc"
        android:textColor="#B0BEC5"
        android:textSize="12sp" />
</LinearLayout>